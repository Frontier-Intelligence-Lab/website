# Copy to .env for local preview. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Required in production (>= 32 random characters). Auto-generated in development only.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
# Local development (plain HTTP, no proxy): leave both as below.
# Production: COOKIE_SECURE must be true (the server refuses to start otherwise) and
# TRUST_PROXY must list the reverse proxy's IP or CIDR, e.g. TRUST_PROXY=172.18.0.2 or
# TRUST_PROXY=172.18.0.0/16. "true" is rejected in production because it trusts any
# X-Forwarded-For value and lets rate limits be bypassed.
TRUST_PROXY=false
COOKIE_SECURE=false
# Optional extra allowed origin for form posts, e.g. https://frontierintelligencelab.com
PUBLIC_ORIGIN=

# Contact delivery: "disabled" (form fails closed) or "smtp".
CONTACT_DELIVERY=disabled
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@frontierintelligencelab.com
SMTP_PASS=
CONTACT_TO=contact@frontierintelligencelab.com
CONTACT_FROM=contact@frontierintelligencelab.com

# Shown publicly on /contact.
CONTACT_PUBLIC_EMAIL=contact@frontierintelligencelab.com
BOOKING_URL=https://cal.com/ayushozha/15-min-getting-to-know

# Reviewer accounts for /demo. Leave both unset to keep sign-in disabled.
# REVIEWERS_FILE=/run/secrets/reviewers.json
# REVIEWERS_JSON=[{"username":"reviewer","name":"Reviewer","role":"viewer","passwordHash":"scrypt$..."}]

# Sign-in log (JSON Lines). Unset keeps only the latest 200 events in memory.
# SIGNIN_LOG_FILE=/data/signins.jsonl

# The one workspace the /demo reviewer overview reads: the id printed by scripts/seed-demo.js (a UUID). The workspace
# must also carry profile.synthetic = true. Unset means the overview says it is not configured; no sample data is shown.
# DEMO_WORKSPACE_ID=

# Open-weight models offered on the Models pages: a JSON array read and checked once at startup (format and
# example entries in docs/model-catalog.example.json). Unset means an empty catalog: nothing to pull and no new
# enhance plans; pulls and runs already recorded stay readable. An invalid file stops the server with the reason.
# MODEL_CATALOG_FILE=docs/model-catalog.example.json

# Accounts and onboarding (docs/STORE_CONTRACT.md).
# DATABASE_URL unset: in-memory store outside production (lost on restart); production returns 503 for account routes.
# DATABASE_URL=postgres://valcairn:local-only@127.0.0.1:5432/valcairn
# DATABASE_SSL=disable
# Self-serve sign-up. Defaults to on in development and off in production.
# ACCOUNT_SIGNUP=false

# Sample uploads through services/ingest (Rust). Both values are needed to turn uploads on; the secret must match the ingest service's.
# INGEST_PUBLIC_URL=http://localhost:4100
# INGEST_SHARED_SECRET=replace-with-at-least-32-random-characters
# INGEST_MAX_BYTES=209715200
# Valcairn staff allowed to use the internal review queue at /staff (comma-separated; each must confirm their email).
# STAFF_EMAILS=
# Server-to-server address of services/ingest for commit/delete (default: INGEST_PUBLIC_URL).
# INGEST_INTERNAL_URL=http://valcairn-ingest:4100
# Run on this device: loopback origins of the visitor's own model runtime (Ollama). The browser connects to them
# directly; the server never does. Only http://127.0.0.1, http://localhost or http://[::1] origins are accepted.
# LOCAL_RUNTIME_ORIGINS=http://127.0.0.1:11434,http://localhost:11434
# Models offered for download there: a JSON catalog file (see docs/local-models.example.json). Unset: none offered.
# LOCAL_MODEL_CATALOG_FILE=docs/local-models.example.json
# Memory: loopback origins of a Provena gateway in local-store mode on the visitor's computer. Same rules as above;
# the bearer key for it never reaches this server. Set it empty to turn the Memory page off.
# LOCAL_MEMORY_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Per-project sample limits (files, bytes).
# PROJECT_MAX_FILES=2000
# PROJECT_MAX_BYTES=21474836480
