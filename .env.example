# Copy to .env for local preview. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Required in production (>= 32 random characters). Auto-generated in development only.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
# Local development (plain HTTP, no proxy): leave both as below.
# Production: COOKIE_SECURE must be true (the server refuses to start otherwise) and
# TRUST_PROXY must list the reverse proxy's IP or CIDR, e.g. TRUST_PROXY=172.18.0.2 or
# TRUST_PROXY=172.18.0.0/16. "true" is rejected in production because it trusts any
# X-Forwarded-For value and lets rate limits be bypassed.
TRUST_PROXY=false
COOKIE_SECURE=false
# Optional extra allowed origin for form posts, e.g. https://frontierintelligencelab.com
PUBLIC_ORIGIN=

# Contact delivery: "disabled" (form fails closed) or "smtp".
CONTACT_DELIVERY=disabled
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@frontierintelligencelab.com
SMTP_PASS=
CONTACT_TO=contact@frontierintelligencelab.com
CONTACT_FROM=contact@frontierintelligencelab.com

# Shown publicly on /contact.
CONTACT_PUBLIC_EMAIL=contact@frontierintelligencelab.com
BOOKING_URL=https://cal.com/ayushozha/15-min-getting-to-know

# Reviewer accounts for /demo. Leave both unset to keep sign-in disabled.
# REVIEWERS_FILE=/run/secrets/reviewers.json
# REVIEWERS_JSON=[{"email":"reviewer@example.com","name":"Reviewer","passwordHash":"scrypt$..."}]
