{
  "name": "valcairn-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Valcairn by Frontier Intelligence Labs: React site (homepage, contact, reviewer sign-in, protected workspace dashboard) served by a Fastify API.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "vite build && node --check src/server.js && npm test",
    "reviewer:hash": "node scripts/hash-password.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vite": "^8.3.5"
  }
}
